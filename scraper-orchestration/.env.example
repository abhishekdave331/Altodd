DB_HOST=localhost
DB_PORT=5432
DB_NAME=altodd_market
DB_USER=postgres
DB_PASSWORD=your_password

# Same actor used by the existing manual/scheduled pipeline
# (linkedin-jobs-scraper, deployed Actor ID WoIkcryaPU8xUSqP0) - orchestration
# triggers dynamic runs against this same actor, it does not deploy a new one.
APIFY_ACTOR_ID=WoIkcryaPU8xUSqP0

# Small default so validation runs finish quickly; real personalized runs can
# override via env, never hardcoded into orchestration logic itself.
DEFAULT_MAX_ITEMS=25
